import cv2
import numpy as np

cap = cv2.VideoCapture("road.mp4")

if not cap.isOpened():
    print("Error: Cannot open video")
    exit()

width = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))
height = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))
fps = cap.get(cv2.CAP_PROP_FPS)

fourcc = cv2.VideoWriter_fourcc(*'mp4v')
out = cv2.VideoWriter("perspective_video_output.mp4", fourcc, fps, (width, height))

while True:
    ret, frame = cap.read()

    if not ret:
        break

    src = np.float32([
        [0, 0],
        [width, 0],
        [0, height],
        [width, height]
    ])

   
    dst = np.float32([
        [200, 0],
        [width - 200, 0],
        [0, height],
        [width, height]
    ])

   
    matrix = cv2.getPerspectiveTransform(src, dst)


    transformed = cv2.warpPerspective(frame, matrix, (width, height))

    cv2.imshow("Original Video", frame)
    cv2.imshow("Perspective Transformed Video", transformed)

    # Save transformed frame
    out.write(transformed)

 
    if cv2.waitKey(25) & 0xFF == ord('q'):
        break


cap.release()
out.release()
cv2.destroyAllWindows()
