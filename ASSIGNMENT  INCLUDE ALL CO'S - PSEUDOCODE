"x": int(x), "y": int(y),
"w": int(w), "h": int(h),
"aspect_ratio": float(aspect_ratio)
})

return binary, edges, features

def motion_mask(frame, bg_subtractor):
"""Foreground mask for dynamic scenes."""
mask = bg_subtractor.apply(frame)
kernel = np.ones((5, 5), np.uint8)
mask = cv2.morphologyEx(mask, cv2.MORPH_OPEN, kernel)
mask = cv2.morphologyEx(mask, cv2.MORPH_DILATE, kernel)
return mask

def draw_yolo_results(frame, result):
"""Draw detections and return target-object counts."""
counts = Counter()

if result.boxes is None:
return frame, counts

names = result.names

for box in result.boxes:
cls_id = int(box.cls[0].item())
conf = float(box.conf[0].item())
label = names[cls_id]

if label not in TARGET_CLASSES or conf < 0.35:
continue

