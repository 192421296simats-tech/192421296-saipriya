x1, y1, x2, y2 = map(int, box.xyxy[0].tolist())
counts[label] += 1

cv2.rectangle(frame, (x1, y1), (x2, y2), (0, 255, 0), 2)
text = f"{label} {conf:.2f}"
cv2.putText(
frame, text, (x1, max(20, y1 - 8)),
cv2.FONT_HERSHEY_SIMPLEX, 0.55, (0, 255, 0), 2
)

return frame, counts

def process_source(source, output_dir, model_path="yolov8n.pt"):
os.makedirs(output_dir, exist_ok=True)

# YOLO model is downloaded automatically on first run if unavailable.
model = YOLO(model_path)

bg_subtractor = cv2.createBackgroundSubtractorMOG2(
history=500, varThreshold=40, detectShadows=True
)

is_image = isinstance(source, str) and source.lower().endswith(
(".jpg", ".jpeg", ".png", ".bmp", ".webp")
)

log_path = os.path.join(output_dir, "detections.csv")
csv_file = open(log_path, "w", newline="", encoding="utf-8")
writer = csv.writer(csv_file)
writer.writerow(["frame", "object", "confidence", "fps"])

